# Server configuration. Keep production values outside source control.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/al_hospitality?schema=public"
SESSION_SECRET="replace-with-a-long-random-secret"
FRONTEND_ORIGIN="http://127.0.0.1:5173"
API_PORT=4000
COOKIE_SECURE=false
# Comma-separated, pre-existing designated accounts. These values are never exposed to the frontend.
COFOUNDER_EMAILS="owner@example.com,lekaa@example.com"
# Optional SMTP notification configuration.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AL Hospitality <no-reply@example.com>"
